def predict_delta(
    block,
    tree=0.0,
    non_tree=0.0,
    water=0.0
):
    baseline = block_X[block]
    scenario = baseline.copy()

    scenario[:, TREE_I] += tree
    scenario[:, NONTREE_I] += non_tree
    scenario[:, WATER_I] += water

    scenario[:, BARE_I] = np.clip(
        scenario[:, BARE_I]
        - (tree + non_tree + water),
        0,
        None
    )

    baseline_mean = (
        best_model
        .predict(baseline)
        .mean()
    )

    scenario_mean = (
        best_model
        .predict(scenario)
        .mean()
    )

    return float(
        scenario_mean - baseline_mean
    )


def block_weights(block):
    bare_budget = float(
        block_X[block][:, BARE_I].mean()
    )

    effects = {
        "tree": predict_delta(
            block,
            tree=bare_budget
        ),
        "non_tree": predict_delta(
            block,
            non_tree=bare_budget
        ),
        "water": predict_delta(
            block,
            water=bare_budget
        )
    }

    cooling = {
        name: abs(delta)
        for name, delta in effects.items()
        if delta < 0
    }

    if not cooling:
        return None

    total = sum(cooling.values())

    return {
        name: cooling.get(name, 0.0) / total
        for name in [
            "tree",
            "non_tree",
            "water"
        ]
    }


def derive_scenario(
    block,
    target_delta,
    step=0.005
):
    weights = block_weights(block)

    bare_budget = float(
        block_X[block][:, BARE_I].mean()
    )

    tree = 0.0
    non_tree = 0.0
    water = 0.0

    if weights is None:
        return {
            "block": block,
            "target": target_delta,
            "achieved": 0.0,
            "tree": 0.0,
            "non_tree": 0.0,
            "water": 0.0,
            "bare": 0.0,
            "feasible": False
        }

    while (
        tree
        + non_tree
        + water
        + step
        <= bare_budget + 1e-9
    ):
        tree += (
            step
            * weights["tree"]
        )

        non_tree += (
            step
            * weights["non_tree"]
        )

        water += (
            step
            * weights["water"]
        )

        delta = predict_delta(
            block,
            tree=tree,
            non_tree=non_tree,
            water=water
        )

        if delta <= target_delta:
            return {
                "block": block,
                "target": target_delta,
                "achieved": round(delta, 3),
                "tree": round(tree, 4),
                "non_tree": round(non_tree, 4),
                "water": round(water, 4),
                "bare": round(
                    -(tree + non_tree + water),
                    4
                ),
                "feasible": True
            }


    delta = predict_delta(
        block,
        tree=tree,
        non_tree=non_tree,
        water=water
    )

    return {
        "block": block,
        "target": target_delta,
        "achieved": round(delta, 3),
        "tree": round(tree, 4),
        "non_tree": round(non_tree, 4),
        "water": round(water, 4),
        "bare": round(
            -(tree + non_tree + water),
            4
        ),
        "feasible": False
    }


